<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - NOT FOUND</title>
    <style>
        /* Basic Page Formatting*/
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background-color: #050505; 
            color: #8b0000; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            overflow: hidden; 
            user-select: none; 
        }
        
        .container { text-align: center; z-index: 1; }
        h1 { font-size: 6rem; letter-spacing: 10px; margin-bottom: 10px; text-shadow: 0 0 10px rgba(139, 0, 0, 0.7); }
        p { font-size: 1.2rem; color: #555; margin-bottom: 30px; font-weight: bold; }
        
        /* Back Button */
        .fake-btn { 
            background: transparent; 
            border: 2px solid #8b0000; 
            color: #8b0000; 
            padding: 10px 20px; 
            font-size: 1rem; 
            cursor: pointer; 
            font-family: inherit; 
            text-transform: uppercase; 
            transition: all 0.2s;
        }
        .fake-btn:hover {
            background-color: #8b0000;
            color: #050505;
            box-shadow: 0 0 15px #8b0000;
        }

        /* The Jumpscare */
        .jumpscare-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #000;
            z-index: 10;
            display: none;
            justify-content: center;
            align-items: center;
        }

        /* Jumpscare face part*/
        .scary-face {
            width: 250px;
            height: 350px;
            position: relative;
        }
        /* Jumpscare eyes part */
        .scary-face::before {
            content: '';
            position: absolute;
            top: 20%;
            left: 10px;
            width: 60px;
            height: 60px;
            background: #fff;
            border-radius: 50%;
            box-shadow: 170px 0 0 #fff, 0 0 30px #ff0000, 170px 0 30px #ff0000;
        }
        /* Jumpscare Mouth Part */
        .scary-face::after {
            content: '';
            position: absolute;
            bottom: 10%;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 150px;
            background: #000;
            border: 4px solid #fff;
            border-radius: 50%;
            box-shadow: 0 0 20px #ff0000;
        }

        /* Backround Flashing  */
        @keyframes flash {
            0%, 100% { background-color: #000; }
            50% { background-color: #400000; }
        }

        /* Jumpscare animation */
        @keyframes shake {
            0% { transform: scale(0.8) translate(0, 0); }
            10% { transform: scale(1.1) translate(-10px, 5px); }
            20% { transform: scale(1.4) translate(15px, -10px); }
            30% { transform: scale(1.8) translate(-5px, 15px); }
            40% { transform: scale(2.2) translate(10px, -5px); }
            50% { transform: scale(2.5) translate(-15px, 10px); }
            60% { transform: scale(2.8) translate(5px, -15px); }
            70% { transform: scale(3.2) translate(-10px, 5px); }
            80% { transform: scale(3.5) translate(15px, -10px); }
            90% { transform: scale(3.8) translate(-5px, 10px); }
            100% { transform: scale(4) translate(0, 0); opacity: 0; }
        }
        .fake-btn:focus ~ .jumpscare-overlay,
        .fake-btn:active ~ .jumpscare-overlay {
            display: flex;
            animation: flash 0.1s infinite;
        }
        .fake-btn:focus ~ .jumpscare-overlay .scary-face,
        .fake-btn:active ~ .jumpscare-overlay .scary-face {
            animation: shake 1.5s forwards;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>404</h1>
        <p>THERE IS NO GOING BACK.</p>
        <button class="fake-btn">Go Back</button>    
        <div class="jumpscare-overlay">
            <div class="scary-face"></div>
        </div>
    </div>

</body>
</html>


